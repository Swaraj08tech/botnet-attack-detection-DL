# Copy to .env in the repository root (next to docker-compose.yml). Never commit the real .env.
POSTGRES_USER=attack
POSTGRES_PASSWORD=change-me-database-password
# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-10-characters
HTTP_PORT=8080
CORS_ORIGINS=http://localhost:8080
# Use locally built images instead of the published ones:
# BACKEND_IMAGE=attack-detection-backend:local
# FRONTEND_IMAGE=attack-detection-frontend:local
