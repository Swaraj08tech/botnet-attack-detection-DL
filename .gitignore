# Keep reference paper, research documentation and curated results trackable

# Large local folders and third-party documents (kept locally, not published)
/snapshots/
/docs/reference_paper/*.pdf
/research paper source/

# Serving bundle (built locally from models/; published as a release asset)
/serving/bundle/

# Local backend database
/backend/local.db

# Local tool settings
/.claude/

# Zipped serving bundle (attach to the GitHub release instead)
/serving/*.zip

# Local application data (staged uploads, PDF reports)
/backend/data/
