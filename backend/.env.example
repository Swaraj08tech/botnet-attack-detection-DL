# Copy to backend/.env for local development (never commit the real file).
ENVIRONMENT=development
# Long random string; required when ENVIRONMENT=production
JWT_SECRET=change-me-to-a-long-random-string
# First administrator, created on the first start when no users exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-10-characters
# Default: SQLite file backend/local.db. In Docker: postgresql+psycopg://user:password@db:5432/attack_detection
# DATABASE_URL=
BUNDLE_DIR=serving/bundle
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
